# Copy to .env.deploy in this folder (gitignored) and fill in.
# Uses a named AWS CLI profile so your default credentials stay on another account.

DEPLOY_AWS_PROFILE=your-site-profile-name
DEPLOY_S3_BUCKET=your-bucket-name
# Optional: empty or e.g. site/
DEPLOY_S3_PREFIX=

# Optional: CloudFront distribution ID (omit to skip invalidation)
DEPLOY_CLOUDFRONT_DISTRIBUTION_ID=E1234567890ABC
